<Window x:Class="XboxDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Xbox Dashboard"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#080909"
        MinWidth="960"
        MinHeight="600"
        Width="1440"
        Height="840">

    <Grid Background="#080909">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar"
                Grid.Row="0"
                Background="#0A0B0C"
                BorderBrush="#1D1F20"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Border Width="18"
                            Height="18"
                            CornerRadius="9"
                            Background="#107C10"
                            Margin="0,0,8,0">
                        <Viewbox Margin="4">
                            <Path Stroke="White"
                                  StrokeThickness="1.8"
                                  Data="M2,2 L10,10 M10,2 L2,10"/>
                        </Viewbox>
                    </Border>

                    <TextBlock Text="Xbox Dashboard"
                               Foreground="#C9C9C9"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="46"
                            Height="34"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize">
                        <Viewbox Width="11" Height="11">
                            <Path Stroke="#E8E8E8"
                                  StrokeThickness="1.4"
                                  Data="M1,8 L11,8"/>
                        </Viewbox>
                    </Button>

                    <Button Width="46"
                            Height="34"
                            Click="MaximizeButton_Click"
                            ToolTip="Maximize">
                        <Viewbox Width="11" Height="11">
                            <Path Stroke="#E8E8E8"
                                  StrokeThickness="1.2"
                                  Data="M1.5,1.5 L10.5,1.5 L10.5,10.5 L1.5,10.5 Z"/>
                        </Viewbox>
                    </Button>

                    <Button Width="46"
                            Height="34"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <Viewbox Width="11" Height="11">
                            <Path Stroke="#E8E8E8"
                                  StrokeThickness="1.4"
                                  Data="M1.5,1.5 L10.5,10.5 M10.5,1.5 L1.5,10.5"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="DashboardView"
                      Grid.Row="1"
                      DefaultBackgroundColor="#080909"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"/>
    </Grid>
</Window>
